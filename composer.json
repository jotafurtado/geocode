{
    "name": "jcf/geocode",
    "description": "Google Geocoding API for Laravel",
    "keywords": [
        "laravel",
        "google",
        "geocode",
        "geocoding",
        "address",
        "latitude",
        "longitude",
        "api"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "João Carlos",
            "email": "jotacfurtado@gmail.com"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "guzzlehttp/guzzle": "^6.5.8"
    },
    "autoload": {
        "psr-0": {
            "Jcf\\Geocode": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Jcf\\Geocode\\GeocodeServiceProvider"
            ],
            "aliases": {
                "Geocode": "Jcf\\Geocode\\Facades\\Geocode"
            }
        }
    }
}
